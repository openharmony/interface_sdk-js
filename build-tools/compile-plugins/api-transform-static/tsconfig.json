{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "utils/**/*.ts",
    "api-transform-wrapper/**/*.ts",
    "index.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
